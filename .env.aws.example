# Copiar como .env en el servidor (nunca subirlo a Git) y completar los valores.
POSTGRES_DB=chatbot_vectors
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=cambiar_por_una_contraseña_larga

# API key nueva de OpenAI (la de desarrollo quedó expuesta: revocarla)
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Región y tabla de DynamoDB en AWS
AWS_REGION=us-east-1
DYNAMODB_TABLE=chatbot-interacciones
